[Unit]
Description=ARTEX Docker OTA updater
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
StateDirectory=artex-updater
StateDirectoryMode=0700
RuntimeDirectory=artex-updater
RuntimeDirectoryMode=0750
# Keep the bind-mounted directory inode across daemon restarts.
RuntimeDirectoryPreserve=yes
WorkingDirectory=/var/lib/artex-updater
ExecStart=/usr/local/libexec/artex-updater --config /etc/artex-updater/config.json serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Docker and Cosign use root's host registry credentials/cache. Neither the
# Docker socket nor this home directory is mounted into ARTEX by the overlay.

[Install]
WantedBy=multi-user.target
